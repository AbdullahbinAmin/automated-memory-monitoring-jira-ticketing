# Remote SSH Server Configuration
MONITOR_SSH_HOST=192.168.1.100
MONITOR_SSH_USER=ubuntu
MONITOR_SSH_PASSWORD=your_ssh_password_here
MONITOR_SSH_KEY_PATH=/path/to/private_key.pem
MONITOR_SSH_PORT=22

# Monitoring Threshold
MEMORY_THRESHOLD_GB=1

# JIRA Atlassian Integration
JIRA_SERVER_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=devops-alerts@your-domain.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=OPS
JIRA_ASSIGNEE_ID=712020:example-account-id

# SMTP Email Notification Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=devops-alerts@gmail.com
SMTP_PASSWORD=your_google_app_password
ALERT_RECIPIENT_EMAIL=oncall-sre@your-domain.com
